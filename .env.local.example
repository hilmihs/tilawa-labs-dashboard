# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Postgres (Drizzle ORM) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/mabni
# Azure Postgres Flexible requires TLS — append ?sslmode=require to DATABASE_URL
# (auto-detected), or force it here when the URL doesn't say so.
DATABASE_SSL=

# --- Auth (JWT session signing, jose) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=

# --- tilawah.example.org login (server-side only, used by sync + presensi-write) ---
TILAWAH_BASE_URL=https://tilawah.example.org
TILAWAH_LOGIN_EMAIL=
TILAWAH_LOGIN_PASSWORD=

# --- cms.example.com (Nafi') — source for HKM tilawah monitoring ---
BERKAH_BASE_URL=https://cms.example.com
# Needs its OWN active Nafi' admin account (separate activation from tilawah).
# If left blank, falls back to TILAWAH_LOGIN_* (may be inactive on this system).
BERKAH_LOGIN_EMAIL=
BERKAH_LOGIN_PASSWORD=
# Optional escape hatch: paste a browser session cookie to skip programmatic login
# (e.g. if login ever gets a CAPTCHA/2FA). Leave blank to use the login flow.
BERKAH_SESSION_COOKIE=
BERKAH_XSRF_TOKEN=

# --- mabni.example.org (Madrasah Nusantara — sync absensi/piket) ---
MABNI_BASE_URL=https://mabni.example.org/api/v1
MABNI_LOGIN_EMAIL=
MABNI_LOGIN_PASSWORD=

# --- Sumber skor al-Fatihah (scorecard). Ada default di kode. ---
ALFATIHAH_BASE_URL=

# --- maahir.example.org Public API (read-only ingest, docs/API-PUBLIC.md) ---
# Server-to-server ONLY — the key must never reach a browser. GET-only, Bearer key.
MAAHIR_BASE_URL=https://maahir.example.org/api/v1
MAAHIR_API_KEY=

# --- kirimi.id WhatsApp gateway (docs: https://kirimi.id/docs) ---
KIRIMI_USER_CODE=
KIRIMI_SECRET=
# device_id lives under the device/WhatsApp-connection section of the kirimi.id
# dashboard, NOT the API Key page — it's a separate value from user_code/secret.
KIRIMI_DEVICE_ID=

# the operations coordinator's WhatsApp number for SP-required alerts, format 62xxxxxxxxxx (no +, no spaces).
SP_ALERT_WA_NUMBER=

# Coordinator WA numbers shown in the teacher portal. Defaults are already in the
# code (lib/guru-portal/queries.ts) — set these only to override.
COORD_IKHWAN_PHONE=
COORD_AKHWAT_PHONE=

# --- Cron secret (protects /api/cron/* routes from public calls) ---
CRON_SECRET=

# --- Agent read token (protects /api/agent/* — READ ONLY, no writes, no cron) ---
# The Hermes WhatsApp assistant's credential. Separate from CRON_SECRET and
# OPS_SECRET on purpose: it can be rotated or deleted without touching cron, ops,
# or any human account, and it cannot trigger a sync or change anything.
# Blank (or shorter than 24 chars) = every /api/agent/* route 401s. That is the
# kill switch. Generate: openssl rand -base64 32
AGENT_TOKEN=

# --- Ops API secret (protects /api/admin/* — bearer for machines/curl/CI) ---
# Humans use a super_coordinator session instead; this is the machine credential.
# Generate: openssl rand -base64 32
OPS_SECRET=

# --- Storage (surat peringatan PDFs) ---
# "local" = filesystem storage/ dir (dev); "azure_blob" = Azure Blob (prod).
STORAGE_BACKEND=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=storage

# --- Surat Peringatan (piket mabni) ---
# Prefix nomor surat: {PREFIX}/{ROMAWI-BULAN}/{TAHUN}/{urutan}. Default EKT/MPN-MBN.
WARNING_LETTER_PREFIX=

# --- Surat HKM (/[program]/surat) ---
# Penanggungjawab yang tercetak di bawah tanda tangan. Default "Ustadz Idris Hakim".
# Ganti kalau penanggungjawabnya berganti — tanda tangannya di public/surat/ttd-signer.jpg.
HKM_LETTER_SIGNER=

# --- Admin SQL console ---
# Set to "false" untuk matikan halaman /admin/sql di produksi.
ADMIN_SQL_ENABLED=

# Public base URL for magic links (teacher gap-confirmation). Defaults to
# https://dashboard.example.org when unset.
APP_BASE_URL=http://localhost:3000

# Same URL, but read by /api/agent/konfirmasi-rekap. NEXT_PUBLIC_* is compiled
# into the browser bundle — URLs only, never a secret.
NEXT_PUBLIC_APP_URL=

# Experimental write-back: re-PUT tilawah pertemuan as "Selesai" when a teacher
# confirms. Off unless set to exactly "1" — verify on a non-prod tenant first.
TILAWAH_PUSH_TAUGHT=
